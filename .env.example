# =========================================================================
# Atelier 3D Media Engine - Production Environment Variables
# =========================================================================

# -------------------------------------------------------------
# 1. BACKEND (Render Web Service Environment Variables)
# -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database (Render Managed PostgreSQL provides this automatically)
DATABASE_URL=postgres://atelier_user:your_password@dpg-xxxx.oregon-postgres.render.com:5432/atelier_db

# Security & Authentication (Required in prod: >= 32 random characters/bytes)
# Generate with: openssl rand -hex 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATELIER_JWT_SECRET=your_secure_64_character_hex_or_base64_secret_key_here

# Super Admin Account
ATELIER_SUPERADMIN_EMAIL=admin@atelier.local
ATELIER_SUPERADMIN_PASSWORD=YourStrongSuperAdminPassword123!
ATELIER_SUPERADMIN_RESET=false

# Allowed Frontend Origins (Vercel deployment URL + local dev)
ATELIER_CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app,https://*.vercel.app

# AWS S3 Storage (Zero-Server-RAM presigned uploads)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=atelier-ar-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_PUBLIC_BASE_URL=

# Model Caps
ATELIER_MAX_PUBLISHED_MODEL_BYTES=26214400

# -------------------------------------------------------------
# 2. FRONTEND (Vercel Project Environment Variables)
# -------------------------------------------------------------
# Deployed Render backend URL (NO trailing slash)
VITE_API_BASE_URL=https://your-backend-app.onrender.com

# ISO Currency Code
VITE_CURRENCY=USD

# Optional: Sales Demo Contact Email
VITE_SALES_EMAIL=sales@your-domain.com

# Optional: Public Menu Custom Domain (defaults to current origin if empty)
VITE_PUBLIC_MENU_ORIGIN=
