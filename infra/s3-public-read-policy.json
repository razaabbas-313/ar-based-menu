{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadMenuMedia",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::atelier-ar-bucket/restaurant-atelier/*"
    },
    {
      "Sid": "DenyPublicReadPrivateAssets",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::atelier-ar-bucket/restaurant-atelier-private/*"
    }
  ]
}
