# Copy to .env.local and adjust.

# Where the browser calls the API. Leave empty in development: Vite proxies /api to the backend.
# In production (e.g. Vercel) set it to the deployed API origin, e.g. https://atelier-api.onrender.com
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards /api (default http://localhost:8080)
VITE_DEV_API_PROXY=http://localhost:8080

# Currency used to display prices (ISO 4217)
VITE_CURRENCY=USD

# Where "Book a Demo" sends requests (opens the visitor's mail app with the details filled in)
VITE_SALES_EMAIL=

# Public origin encoded in restaurant QR codes, e.g. https://menu.your-domain.com
# Leave empty to use the address the studio is opened from.
VITE_PUBLIC_MENU_ORIGIN=
